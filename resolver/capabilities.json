{
  "schema_version": 1,
  "product": "GoreeCloud DNS",
  "architecture": "single-service",
  "runtime_authority": "GoreeCloud/goreecloud-dns",
  "target_replaces": ["AdGuard Home", "Unbound"],
  "external_recursive_resolver_required": false,
  "capabilities": [
    "recursive-resolution",
    "dns-cache",
    "negative-cache",
    "aggressive-negative-cache",
    "cache-ttl-controls",
    "serve-stale",
    "prefetch",
    "forward-zones",
    "multi-upstream-failover",
    "dnssec-validation",
    "qname-minimization",
    "minimal-responses",
    "local-zones",
    "local-data",
    "response-policy-zones",
    "dns-rebinding-protection",
    "client-access-control",
    "multi-threading",
    "cache-sharding",
    "runtime-statistics",
    "runtime-administration",
    "interface-restrictions",
    "query-restrictions",
    "privilege-separation",
    "resolver-hardening"
  ],
  "production_approved": false,
  "runtime_acceptance_required": true
}
